FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG VITE_PROMETHEUS_URL
ARG VITE_LOKI_URL
ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_AUTHENTIK_URL
ARG VITE_AUTHENTIK_TOKEN
ARG VITE_K8S_TOKEN
ARG VITE_INFISICAL_TOKEN
ENV VITE_PROMETHEUS_URL=$VITE_PROMETHEUS_URL
ENV VITE_LOKI_URL=$VITE_LOKI_URL
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI
ENV VITE_AUTHENTIK_URL=$VITE_AUTHENTIK_URL
ENV VITE_AUTHENTIK_TOKEN=$VITE_AUTHENTIK_TOKEN
ENV VITE_K8S_TOKEN=$VITE_K8S_TOKEN
ENV VITE_INFISICAL_TOKEN=$VITE_INFISICAL_TOKEN

RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
